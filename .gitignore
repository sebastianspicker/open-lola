# open-lola public repository boundary
#
# Keep original source, tests, fixtures, public documentation, and reproducible
# configuration trackable. Keep private evidence, local workflow records,
# generated output, credentials, and tool state outside the public surface.

# Private and internal material
/private/
/internal/
/internals/
/docs/local/
/docs/internal/
/reverse-engineering/
/research/
/win-compiled/
/mac-port/
/docs/review/

# Local archive payloads; retain only the public boundary summary.
/archive/**
!/archive/README.md

# Local instructions, indexes, and machine-specific tool state
/AGENTS.md
/CLAUDE.md
/GEMINI.md
/.agents/
/.claude/
/.codex/
/.codegraph/
/.cursor/
/.impeccable/
/.serena/
/.github/copilot-instructions.md
/docs/agent/
/docs/agents/

# Internal handoffs and local workflow documents
/docs/implementation-handoff.md
/docs/archive-binary-retention-proposal.md
/docs/codacy-remediation-ledger.md
/docs/codacy-status-ledger.md
/scripts/verify_docs/archive_topology.txt

# Connector-local generated lab artifacts
/linux_connector/process_artifacts/**
!/linux_connector/process_artifacts/README.md

