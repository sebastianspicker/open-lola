      "src_ip": "192.0.2.10",
      "dst_ip": "198.51.100.20",
      "sid": 17,
      "txt": "audio settings mismatch",
      "expected_prefix": "/MESG_REJECT;SRCIP:192.0.2.10;DSTIP:198.51.100.20;SID:17;TXT:audio settings mismatch",
      "expected": {"category": "accept", "wire_size": 1024, "sid": 17, "txt": "audio settings mismatch"}
    },
    {
