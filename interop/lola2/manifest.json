{
  "schema": "open-lola.lola2.compatibility-corpus/v1",
  "version": "1.1.0",
  "provenance": {
    "recovered_from": [
      "linux_connector/docs/protocol-reference.md",
      "linux_connector/lola_connector/protocol.py",
      "linux_connector/lola_connector/media.py"
    ],
    "vector_origin": "synthetic reconstruction from documented behaviour and current Python wire codec",
    "original_windows_capture": false
  },
  "categories": {
    "accept": "The input is accepted and produces the stated decoded or encoded wire values.",
    "reject.invalid_sid": "A required SID is absent, empty, non-decimal, or duplicated.",
    "reject.duplicate_field": "A control field appears more than once.",
    "reject.missing_required_fields": "QuickConn or QuickConn ACK omits required media fields.",
    "reject.txt_order": "A field follows TXT, which would make delimiter handling ambiguous.",
    "reject.non_ascii": "The ASCII control codec receives non-ASCII input.",
    "reject.oversize": "A control datagram exceeds the 1024-byte LoLa bound.",
    "reject.serialized_length": "A serialized media payload length does not match its body."
  },
  "cases": [
    {
      "id": "control.quickconn.default.v1",
      "operation": "encode_control",
      "kind": "MESG_QUICKCONN",
      "src_ip": "192.0.2.10",
      "dst_ip": "198.51.100.20",
      "sid": 17,
      "expected_prefix": "/MESG_QUICKCONN;SRCIP:192.0.2.10;DSTIP:198.51.100.20;SID:17;SR:44100;BPS:16;CHNLS:2;FPS:25;BPP:8;X:640;Y:480;COMP:0;BAYER:0",
      "expected": {"category": "accept", "wire_size": 1024, "sid": 17}
    },
    {
      "id": "control.status-ack.default.v1",
      "operation": "encode_control",
      "kind": "MESG_CHECKLOLASTATUS_ACK",
      "src_ip": "192.0.2.10",
      "dst_ip": "198.51.100.20",
      "sid": 17,
      "expected_prefix": "/MESG_CHECKLOLASTATUS_ACK;SRCIP:192.0.2.10;DSTIP:198.51.100.20;SID:17;",
      "expected": {"category": "accept", "wire_size": 1024, "sid": 17}
    },
    {
      "id": "control.chat.punctuation.v1",
      "operation": "encode_control",
      "kind": "MESG_CHAT",
      "src_ip": "192.0.2.10",
      "dst_ip": "198.51.100.20",
      "sid": 17,
      "txt": "Hello; LoLa: 100%",
      "expected_prefix": "/MESG_CHAT;SRCIP:192.0.2.10;DSTIP:198.51.100.20;SID:17;TXT:Hello%3B LoLa%3A 100%25",
      "expected": {"category": "accept", "wire_size": 1024, "sid": 17, "txt": "Hello; LoLa: 100%"}
    },
    {
      "id": "control.reject.text.v1",
